# Start kbd-backlight-sync.service once the ASUS keyboard backlight exists.
# (The systemd tag goes on every event, not just "add", or systemd would treat
# the device as gone after a "change" event.)
SUBSYSTEM=="leds", KERNEL=="asus::kbd_backlight", TAG+="systemd", ENV{SYSTEMD_WANTS}+="kbd-backlight-sync.service"
