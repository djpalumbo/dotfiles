#!/usr/bin/env python3
"""Fetch more Apple aerial videos for the aerial-fade SDDM theme.

Picks random 1080p H.264 videos from Apple's aerial manifest that aren't
already downloaded, saves them as "<Label> - <apple filename>.mov", and
rebuilds the theme's local playlist from whatever is in the videos dir.

Usage: aerial-fetch [COUNT]          download COUNT new videos (default 3)
       aerial-fetch --max-mb N ...   skip videos larger than N MB (default 250)
       aerial-fetch --playlist-only  just rebuild the playlist

Videos live in the theme dir because the greeter (user `sddm`) can't read
$HOME; ~/Videos/aerial-sddm-theme is a symlink to it.
"""
import argparse
import json
import random
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path

THEME = Path("/usr/share/sddm/themes/aerial-fade")
VIDEOS = THEME / "videos"
PLAYLIST = THEME / "playlists" / "local.m3u"
MANIFEST_URL = "https://sylvan.apple.com/Aerials/resources-16.tar"
CACHE = Path.home() / ".cache" / "aerial-fetch" / "entries.json"
# Apple's sylvan.apple.com certificate doesn't validate, hence curl -k.
CURL = ["curl", "-kfL", "--retry", "2"]


def load_manifest(refresh: bool) -> list[dict]:
    if refresh or not CACHE.exists():
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory() as tmp:
            tar_path = Path(tmp) / "resources.tar"
            subprocess.run([*CURL, "-s", "-o", str(tar_path), MANIFEST_URL], check=True)
            with tarfile.open(tar_path) as tar:
                data = tar.extractfile("entries.json").read()
        CACHE.write_bytes(data)
    return [a for a in json.loads(CACHE.read_text())["assets"] if a.get("url-1080-SDR")]


def remote_size(url: str) -> int | None:
    out = subprocess.run([*CURL, "-sI", "-m", "20", url], capture_output=True, text=True).stdout
    for line in out.splitlines():
        if line.lower().startswith("content-length:"):
            return int(line.split(":", 1)[1])
    return None


def safe_label(label: str) -> str:
    return "".join(c for c in label if c not in '/\\:*?"<>|').strip() or "Aerial"


def rebuild_playlist() -> int:
    files = sorted(p for p in VIDEOS.iterdir() if p.suffix.lower() in {".mov", ".mp4"})
    PLAYLIST.write_text("".join(f"{p.as_uri()}\n" for p in files))
    return len(files)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("count", nargs="?", type=int, default=3)
    ap.add_argument("--max-mb", type=int, default=250)
    ap.add_argument("--hevc", action="store_true",
                    help="fetch HEVC 10-bit instead of H.264 (smaller, but this "
                         "laptop's GPU can't decode it, so it stutters)")
    ap.add_argument("--refresh", action="store_true", help="re-download Apple's manifest")
    ap.add_argument("--playlist-only", action="store_true")
    args = ap.parse_args()

    if args.playlist_only:
        print(f"Playlist: {rebuild_playlist()} videos")
        return 0

    key = "url-1080-SDR" if args.hevc else "url-1080-H264"
    have = {p.name.rsplit(" - ", 1)[-1] for p in VIDEOS.iterdir()}
    # A video counts as downloaded in either codec.
    candidates = [a for a in load_manifest(args.refresh)
                  if a.get(key) and not any(
                      Path(a.get(k, "")).name in have for k in ("url-1080-SDR", "url-1080-H264"))]
    random.shuffle(candidates)
    print(f"{len(have)} downloaded, {len(candidates)} available")

    got = 0
    for a in candidates:
        if got >= args.count:
            break
        url = a[key]
        size = remote_size(url)
        if size is None or size > args.max_mb * 1024 * 1024:
            continue
        dest = VIDEOS / f"{safe_label(a.get('accessibilityLabel', ''))} - {Path(url).name}"
        part = dest.with_name(dest.name + ".part")
        print(f"[{got + 1}/{args.count}] {dest.name} ({size // 1048576} MB)")
        if subprocess.run([*CURL, "-#", "-o", str(part), url]).returncode != 0:
            part.unlink(missing_ok=True)
            print("  download failed, skipping", file=sys.stderr)
            continue
        part.rename(dest)
        got += 1

    print(f"Downloaded {got}. Playlist: {rebuild_playlist()} videos")
    return 0 if got == args.count else 1


if __name__ == "__main__":
    sys.exit(main())
